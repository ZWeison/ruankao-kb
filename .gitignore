# Obsidian 本地工作区状态（与机器相关，不入库）
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/*/data.json
.obsidian/plugins/*/*.map

# Obsidian 新建未命名的空壳文件
未命名*.md
未命名*.base
未命名*.canvas

# 系统垃圾文件
Thumbs.db
desktop.ini
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/

# 临时文件
*.tmp
~$*

# 抓取暂存区（源仓库克隆、下载的 PDF 原料）—— 不入库
_staging/

# 助手工作目录（本地记忆/缓存）—— 不入库
.workbuddy/
